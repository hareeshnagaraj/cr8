# Copy to ops/env and fill in. ops/env is gitignored.
export CR8_DEPLOY_REMOTE="you@your-server"
export CR8_DEPLOY_APP_DIR="~/cr8/Catalog"
export CR8_LAUNCHD_WEB="com.cr8.web"
export CR8_LAUNCHD_API="com.cr8.api"
export CR8_SMOKE_ORIGIN="https://your.domain"
export CR8_SMOKE_USER="owner"
# optional: export CR8_SMOKE_PASSWORD_FILE="/path/to/password"
